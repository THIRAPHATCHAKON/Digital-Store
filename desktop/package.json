{
  "name": "digital-store-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Digital Store for Windows",
  "author": "sukpat.dev",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron smoke.js",
    "icon": "electron make-icon.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.sukpat.digital-store",
    "productName": "Digital Store",
    "electronDist": "node_modules/electron/dist",
    "files": ["main.js", "offline.html"],
    "win": { "target": "nsis" }
  }
}
