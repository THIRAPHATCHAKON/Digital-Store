# The store's address. Its DNS A record must already point at this server, and ports 80 + 443 must be open.
DOMAIN=shop.example.com

# The admin account: sign in at /admin/login. Re-applied on every start, so change the password here.
# Wrap the password in 'single quotes' if it contains $ or #.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PK=pk_test_...
# Stripe Dashboard → Developers → Webhooks → endpoint https://<DOMAIN>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# optional: "continue with Google" (OAuth client ID, type "Web application"). Leave empty to hide the button.
GOOGLE_CLIENT_ID=

# Supabase (Vercel production): use the Session pooler connection string if IPv4 is required.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=digital-store
APP_SECRET=replace-with-a-long-random-secret

# local dev only (compose sets these itself)
UPLOAD_DIR=./uploads
